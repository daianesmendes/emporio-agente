# Any OpenAI-compatible provider works.
# Default: Google Gemini (free tier) — create a key at https://aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

# Models in order of preference, comma-separated.
# If one fails (429 quota, 503 overload, timeout), the agent moves to the next one.
# Order chosen by measuring latency on the free tier (see README).
LLM_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Reasoning effort (Gemini: low/medium/high). Leave empty for providers that do not accept it (Groq, Ollama).
LLM_REASONING_EFFORT=low

# --- Alternatives (replace the variables above) ---
# Groq (free):     LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:          LLM_BASE_URL=https://api.openai.com/v1
# Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama

# The agent's "now" (return deadlines, store open/closed). Format: YYYY-MM-DD HH:MM
# Order data goes up to March 2026; a fixed date keeps the examples reproducible.
# Leave empty to use the system clock.
AGENT_NOW=2026-03-25 14:00

# --- Backup provider (optional) ---
# Used when every model of the main provider fails. E.g. Groq (free tier).
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
LLM_FALLBACK_REASONING_EFFORT=
