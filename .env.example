# Qualquer provedor compatível com a API da OpenAI funciona.
# Padrão: Google Gemini (plano gratuito) — crie a chave em https://aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=cole-sua-chave-aqui

# Modelos em ordem de preferência, separados por vírgula.
# Se um falhar (429 cota, 503 sobrecarga, timeout), o agente passa para o próximo.
# Ordem definida medindo latência no plano gratuito (ver README).
LLM_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Nível de raciocínio (Gemini: low/medium/high). Deixe vazio para Groq/Ollama.
LLM_REASONING_EFFORT=low

# --- Alternativas (troque as três variáveis acima) ---
# Groq (gratuito):  LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:           LLM_BASE_URL=https://api.openai.com/v1
# Ollama (local):   LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama

# "Agora" do agente (prazos de troca, loja aberta/fechada). Formato: AAAA-MM-DD HH:MM
# Os dados de pedidos vão até março/2026; fixar a data deixa os exemplos reproduzíveis.
# Deixe vazio para usar o relógio do sistema.
AGENT_NOW=2026-03-25 14:00
